---
import { ArrowRight } from '@lucide/astro';
import { getImage } from 'astro:assets';
import ctaPoster from '../../assets/media/suv-premium-detailing.webp';

const { src: ctaPosterSrc } = await getImage({ src: ctaPoster, format: 'webp', width: 1920 });
---

<section class="relative py-32 overflow-hidden">
  <div class="absolute inset-0 z-0">
    <video
      class="absolute inset-0 w-full h-full object-cover motion-reduce:hidden"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={ctaPosterSrc}
    >
      <source src="/media/cta-car-transform-video.mp4" type="video/mp4" />
    </video>
    <div class="hidden motion-reduce:block absolute inset-0 z-0 bg-gradient-to-br from-gray-900 to-gray-700" />
  </div>

  <div class="container relative z-20 mx-auto px-4 text-center">
    <h2 class="text-[40px] md:text-[48px] font-heading font-medium text-white mb-8 leading-tight">
      We Don't Just Clean Cars,<br />
      We Transform Them
    </h2>

    <div class="max-w-2xl mx-auto mb-12">
      <p class="text-[16px] font-body text-white/90 leading-relaxed">
        From deep detailing to paint protection, we bring out the best in every ride.
        In Karachi or at your doorstep, we've got your car covered.
      </p>
    </div>

    <div class="flex justify-center">
      <a href="/calendar" class="bg-white text-black hover:bg-gray-100 rounded-none px-7.5 py-3.75 h-auto text-xs tracking-[1.3px] font-normal uppercase flex items-center gap-3 transition-colors">
        <span>Book Appointment</span>
        <ArrowRight size={20} />
      </a>
    </div>
  </div>
</section>
