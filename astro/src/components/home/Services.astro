---
const services = [
  {
    title: 'Premium Interior & Exterior Detailing',
    bg: '/media/501-homepage-007.webp',
    icon: `<path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/>`,
  },
  {
    title: 'Paint Protection Film (PPF)',
    bg: '/media/501-homepage-008.webp',
    icon: `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>`,
  },
  {
    title: 'Paint Correction & Polishing',
    bg: '/media/501-homepage-009.webp',
    icon: `<path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/>`,
  },
  {
    title: 'Ceramic Coating',
    bg: '/media/501-homepage-010.webp',
    icon: `<path d="M6 3h12l4 6-10 13L2 9Z"/><path d="M11 3 8 9l4 13 4-13-3-6"/><path d="M2 9h20"/>`,
  },
  {
    title: 'Window Tinting',
    bg: '/media/501-homepage-011.webp',
    icon: `<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>`,
  },
];
---

<section class="pt-8 pb-24 bg-background">
  <div class="container mx-auto px-4 mb-16">
    <div class="flex flex-col md:flex-row items-center justify-center gap-8">
      <h2
        class="text-[40px] font-heading font-medium text-foreground animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 0% entry 50%"
      >
        Our Services
      </h2>
      <div
        class="hidden md:block w-px h-10 bg-foreground/20 animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 5% entry 55%"
      ></div>
      <div
        class="flex flex-wrap justify-center gap-1.5 text-[16px] font-body text-foreground/80 text-center animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 10% entry 60%"
      >
        <span>Based in Karachi</span>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <div
          class={`group relative h-[450px] overflow-hidden cursor-pointer animate-slight-twist ${i === 3 ? 'lg:col-span-2' : ''}`}
          style={`animation-timeline: view(); animation-range: entry ${i * 5}% entry ${i * 5 + 50}%`}
        >
          <div class="absolute inset-0">
            <img
              src={service.bg}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-90 transition-opacity duration-500 group-hover:opacity-100" />
          </div>

          <div class="absolute bottom-0 left-0 w-full p-8 flex flex-col justify-end h-full">
            <div class="w-10 h-10 mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full text-white" set:html={service.icon} />
            </div>
            <h3 class="text-[30px] font-heading font-normal text-white leading-tight">
              {service.title}
            </h3>
            <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
              <div class="absolute top-0 left-0 w-full h-full border border-white/10 group-hover:border-white/30 transition-colors"></div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex justify-center mt-16">
      <a
        href="/calendar"
        class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-none px-7.5 py-3.75 h-auto text-xs tracking-[1.3px] font-sans font-normal uppercase flex items-center gap-3 transition-colors animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 0% entry 50%"
      >
        <span>Book Appointment</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>
        </svg>
      </a>
    </div>
  </div>
</section>
