---
import { Image } from 'astro:assets';
import { Sparkles, Shield, Wand2, Gem, Sun, Calendar } from '@lucide/astro';
import bg1 from '../../assets/media/501-homepage-007.webp';
import bg2 from '../../assets/media/501-homepage-008.webp';
import bg3 from '../../assets/media/501-homepage-009.webp';
import bg4 from '../../assets/media/501-homepage-010.webp';
import bg5 from '../../assets/media/501-homepage-011.webp';

const services = [
  {
    title: 'Premium Interior & Exterior Detailing',
    bg: bg1,
    Icon: Sparkles,
  },
  {
    title: 'Paint Protection Film (PPF)',
    bg: bg2,
    Icon: Shield,
  },
  {
    title: 'Paint Correction & Polishing',
    bg: bg3,
    Icon: Wand2,
  },
  {
    title: 'Ceramic Coating',
    bg: bg4,
    Icon: Gem,
  },
  {
    title: 'Window Tinting',
    bg: bg5,
    Icon: Sun,
  },
];
---

<section class="pt-8 pb-24 bg-background">
  <div class="container mx-auto px-4 mb-16">
    <div class="flex flex-col md:flex-row items-center justify-center gap-8">
      <h2
        class="text-[40px] font-heading font-medium text-foreground animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 0% entry 50%"
      >
        Our Services
      </h2>
      <div
        class="hidden md:block w-px h-10 bg-foreground/20 animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 5% entry 55%"
      ></div>
      <div
        class="flex flex-wrap justify-center gap-1.5 text-[16px] font-body text-foreground/80 text-center animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 10% entry 60%"
      >
        <span>Based in Karachi</span>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {services.map((service, i) => (
        <div
          class={`group relative h-[450px] overflow-hidden cursor-pointer animate-slight-twist ${i === 3 ? 'lg:col-span-2' : ''}`}
          style={`animation-timeline: view(); animation-range: entry ${i * 5}% entry ${i * 5 + 50}%`}
        >
          <div class="absolute inset-0">
            <Image
              src={service.bg}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              alt=""
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-90 transition-opacity duration-500 group-hover:opacity-100" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/20 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-90" />
          </div>

          <div class="absolute bottom-0 left-0 w-full p-8 flex flex-col justify-end h-full">
            <div class="w-10 h-10 mb-6">
              <service.Icon class="w-full h-full text-white" />
            </div>
            <h3 class="text-[30px] font-heading font-normal text-white leading-tight">
              {service.title}
            </h3>
            <div class="absolute top-0 left-0 w-full h-full pointer-events-none">
              <div class="absolute top-0 left-0 w-full h-full border border-white/10 group-hover:border-white/30 transition-colors"></div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="flex justify-center mt-16">
      <a
        href="/calendar"
        class="bg-primary text-primary-foreground hover:bg-primary/90 rounded-none px-7.5 py-3.75 h-auto text-xs tracking-[1.3px] font-sans font-normal uppercase flex items-center gap-3 transition-colors animate-hero-fade-up"
        style="animation-timeline: view(); animation-range: entry 0% entry 50%"
      >
        <span>Book Appointment</span>
        <Calendar size={20} />
      </a>
    </div>
  </div>
</section>
