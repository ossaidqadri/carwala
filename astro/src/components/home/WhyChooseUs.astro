---
const features = [
  {
    title: 'Professional-grade products & tools',
    icon: `<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>`,
  },
  {
    title: 'Mobile & in-shop service options',
    icon: `<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>`,
  },
  {
    title: 'Paint-safe techniques by trained experts',
    icon: `<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/>`,
  },
  {
    title: 'Guaranteed results, not just promises',
    icon: `<path d="m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526"/><circle cx="12" cy="8" r="6"/>`,
  },
];
---

<section class="pt-24 pb-0 bg-background">
  <div class="container mx-auto px-4 mb-16" data-animate-section data-threshold="0.1">
    <div class="flex items-center justify-center gap-[var(--gap-section-header)]">
      <h2 class="section-heading text-foreground font-heading opacity-0" data-animate="animate-hero-fade-up">
        Why Choose Us?
      </h2>
      <div class="h-[var(--divider-height)] w-px bg-foreground opacity-0" data-animate="animate-hero-fade-up" style="animation-delay: 100ms"></div>
      <div class="flex gap-[5px] section-subheading text-foreground font-body opacity-0" data-animate="animate-hero-fade-up" style="animation-delay: 200ms">
        <span>More</span>
        <span>Than</span>
        <span>Clean</span>
      </div>
    </div>
  </div>

  <div class="container mx-auto px-4" data-animate-section data-threshold="0.2">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
      <div class="lg:col-span-4 relative min-h-[400px] bg-black overflow-hidden group">
        <video
          class="absolute inset-0 w-full h-full object-cover motion-reduce:hidden"
          data-animate="animate-why-choose-video"
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
        >
          <source src="/media/501-homepage-003.mp4" type="video/mp4" />
        </video>
        <div class="hidden motion-reduce:block absolute inset-0 bg-gradient-to-br from-gray-900 to-gray-700" />
      </div>

      <div class="lg:col-span-8 grid grid-cols-1 md:grid-cols-2">
        {features.map((feature, i) => (
          <div
            class="group p-10 border border-border hover:bg-muted/30 transition-all duration-300 flex flex-col gap-6 h-full justify-center relative overflow-hidden opacity-0"
            data-animate="opacity-100"
            style={`transition-delay: ${i * 150}ms`}
          >
            <div class="absolute top-0 left-0 w-full h-[1px] bg-destructive/30 origin-left"></div>
            <div class="absolute bottom-0 right-0 w-full h-[1px] bg-destructive/30 origin-right"></div>

            <div class="w-16 h-16 opacity-0" data-animate="animate-why-choose-icon" style={`animation-delay: ${i * 150}ms`}>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full text-destructive group-hover:scale-110 transition-transform duration-300" set:html={feature.icon} />
            </div>

            <h3 class="text-[28px] font-heading leading-tight font-normal max-w-[280px] opacity-0" data-animate="animate-why-choose-title" style={`animation-delay: ${i * 150 + 100}ms`}>
              {feature.title}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/animate-on-scroll';
</script>
