---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingWidget from '../components/booking-calendar/booking-widget';
import { Header } from '../components/home/Header';
import { Footer } from '../components/home/Footer';

const SERVICES = [
  {
    id: "silver",
    name: "Silver Package",
    eventTypeId: import.meta.env.PUBLIC_CALCOM_SILVER_EVENT_TYPE_ID || "",
    duration: 30,
    description: "Essential care — exterior wash, interior vacuum & dashboard wipe",
  },
  {
    id: "gold",
    name: "Gold Package",
    eventTypeId: import.meta.env.PUBLIC_CALCOM_GOLD_EVENT_TYPE_ID || "",
    duration: 60,
    description: "Premium treatment — deep clean, seat shampooing & engine bay",
  },
  {
    id: "diamond",
    name: "Diamond Package",
    eventTypeId: import.meta.env.PUBLIC_CALCOM_DIAMOND_EVENT_TYPE_ID || "",
    duration: 720,
    description: "The ultimate transformation — full paint correction, multi-layer ceramic coating, interior restoration, engine bay detailing & lifetime protection",
  },
];

const initialServiceId = Astro.url.searchParams.get('service');
---

<BaseLayout title="Book Appointment | Carwala">
  <Header client:load />
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:outline-none">Skip to main content</a>
  <main id="main-content" class="min-h-screen bg-background pt-[80px]">
    <div class="container mx-auto w-full max-w-7xl px-4 py-4 sm:px-6 sm:py-8 lg:px-8">
      <div class="mb-6 flex flex-col gap-4 sm:mb-8 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex-1">
          <h1 class="text-2xl font-bold sm:text-3xl font-heading">Book Your Car Detailing Appointment</h1>
          <p class="mt-1 text-sm text-muted-foreground sm:text-base font-body">
            Select your preferred package and time slot — we'll take care of the rest
          </p>
        </div>
      </div>

      <BookingWidget
        client:load
        services={SERVICES}
        initialServiceId={initialServiceId || undefined}
        title="Book Your Car Detailing Appointment"
        description="Choose your package and pick a convenient time for your vehicle"
        showHeader={false}
      />
    </div>
  </main>
  <Footer />
</BaseLayout>