---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/home/Header';
import Hero from '../components/home/Hero.astro';
import WhyChooseUs from '../components/home/WhyChooseUs.astro';
import Services from '../components/home/Services.astro';
import CallToAction from '../components/home/CallToAction.astro';
import { Footer } from '../components/home/Footer';
import ElevenLabsWidget from '../components/ElevenLabsWidget';
---

<BaseLayout title="Premium Car Detailing in Karachi | Car Wala">
  <Header client:load />
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:outline-none">Skip to main content</a>
  <main id="main-content">
    <Hero />
    <WhyChooseUs />
    <Services />
    <CallToAction />
    <ElevenLabsWidget client:idle agentId="agent_0401km3y12mjf95a5h3yspgy3njr" />
  </main>
  <Footer />
</BaseLayout>
