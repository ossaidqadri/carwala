---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/home/Header';
import { Footer } from '../components/home/Footer';
import { Compare } from '../components/ui/compare';
import ElevenLabsWidget from '../components/ElevenLabsWidget';

const galleryImages = [
  { src: '/media/Before/dirty-rear-floor.webp', alt: 'Before - Dirty rear floor with debris and stains' },
  { src: '/media/Before/scratched-roof-paint.webp', alt: 'Before - Scratched and swirled roof paint' },
  { src: '/media/Before/muddy-wheel-arch.webp', alt: 'Before - Muddy wheel arch and dusty tire' },
  { src: '/media/Before/dusty-truck-bed.webp', alt: 'Before - Dusty truck bed with dirty seats' },
  { src: '/media/Before/dirty-driver-floor-mat.webp', alt: 'Before - Dirty driver-side floor mat' },
  { src: '/media/After/glossy-side-panel.webp', alt: 'After - Glossy black side panel with mirror finish' },
  { src: '/media/After/clean-truck-bed.webp', alt: 'After - Clean and polished truck bed' },
  { src: '/media/After/shiny-front-grille.webp', alt: 'After - Shiny front grille and hood' },
  { src: '/media/After/polished-hood-reflection.webp', alt: 'After - Perfect hood reflections after polishing' },
  { src: '/media/After/clean-truck-seats.webp', alt: 'After - Clean truck bed seats' },
];

const comparisonImages = [
  { before: '/media/Before/scratched-roof-paint.webp', after: '/media/After/polished-hood-reflection.webp', title: 'Paint Correction & Polish' },
  { before: '/media/Before/muddy-wheel-arch.webp', after: '/media/After/glossy-side-panel.webp', title: 'Exterior Detail & Wheel Clean' },
  { before: '/media/Before/dusty-truck-bed.webp', after: '/media/After/clean-truck-bed.webp', title: 'Truck Bed Deep Clean' },
  { before: '/media/Before/dirty-rear-floor.webp', after: '/media/After/shiny-front-grille.webp', title: 'Interior Vacuum & Detail' },
  { before: '/media/Before/dirty-driver-floor-mat.webp', after: '/media/After/clean-truck-seats.webp', title: 'Floor Mat Restoration' },
];
---

<BaseLayout title="Car Detailing Gallery | Car Wala" description="View our expert car detailing transformations in Karachi - paint correction, ceramic coating, PPF & more.">
  <Header client:load />
  <main class="min-h-screen bg-background pt-[80px]">
    <div class="container mx-auto px-4 py-12">
      <div class="mb-12 text-center">
        <h1 class="text-2xl font-bold sm:text-3xl font-heading mb-4">
          Car Detailing Gallery
        </h1>
        <p class="text-sm text-muted-foreground sm:text-base font-body">
          Browse our portfolio of premium car care transformations
        </p>
      </div>

      <section class="mb-16">
        <h2 class="text-xl font-bold font-heading mb-6 text-center">
          Real Transformations
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {comparisonImages.map((comparison, i) => (
            <div class="flex flex-col items-center">
              <Compare
                client:visible
                firstImage={comparison.after}
                secondImage={comparison.before}
                firstImageClassName="object-cover w-full h-full"
                secondImageClassname="object-cover w-full h-full"
                className="w-full aspect-square rounded-lg border border-border"
                slideMode="drag"
                autoplay={false}
              />
              <p class="mt-3 text-sm text-muted-foreground font-body">
                {comparison.title}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-bold font-heading mb-6 text-center">
          Detailing Portfolio
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {galleryImages.map((item, i) => (
            <div
              class="group relative aspect-square overflow-hidden rounded-lg bg-muted"
            >
              <img
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer client:visible />
  <ElevenLabsWidget client:idle agentId="agent_0401km3y12mjf95a5h3yspgy3njr" />
</BaseLayout>