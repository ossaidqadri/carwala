---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { Header } from '../components/home/Header';
import { Footer } from '../components/home/Footer';
import Compare from '../components/ui/compare.astro';
import ElevenLabsWidget from '../components/ElevenLabsWidget';
import { Picture } from 'astro:assets';

import dirtyRearFloor from '../assets/media/Before/dirty-rear-floor.webp';
import scratchedRoofPaint from '../assets/media/Before/scratched-roof-paint.webp';
import muddyWheelArch from '../assets/media/Before/muddy-wheel-arch.webp';
import dustyTruckBed from '../assets/media/Before/dusty-truck-bed.webp';
import dirtyDriverFloorMat from '../assets/media/Before/dirty-driver-floor-mat.webp';
import glossySidePanel from '../assets/media/After/glossy-side-panel.webp';
import cleanTruckBed from '../assets/media/After/clean-truck-bed.webp';
import shinyFrontGrille from '../assets/media/After/shiny-front-grille.webp';
import polishedHoodReflection from '../assets/media/After/polished-hood-reflection.webp';
import cleanTruckSeats from '../assets/media/After/clean-truck-seats.webp';

const galleryImages = [
  { src: dirtyRearFloor, alt: 'Before - Dirty rear floor with debris and stains' },
  { src: scratchedRoofPaint, alt: 'Before - Scratched and swirled roof paint' },
  { src: muddyWheelArch, alt: 'Before - Muddy wheel arch and dusty tire' },
  { src: dustyTruckBed, alt: 'Before - Dusty truck bed with dirty seats' },
  { src: dirtyDriverFloorMat, alt: 'Before - Dirty driver-side floor mat' },
  { src: glossySidePanel, alt: 'After - Glossy black side panel with mirror finish' },
  { src: cleanTruckBed, alt: 'After - Clean and polished truck bed' },
  { src: shinyFrontGrille, alt: 'After - Shiny front grille and hood' },
  { src: polishedHoodReflection, alt: 'After - Perfect hood reflections after polishing' },
  { src: cleanTruckSeats, alt: 'After - Clean truck bed seats' },
];

const comparisonImages = [
  { before: scratchedRoofPaint, after: polishedHoodReflection, title: 'Paint Correction & Polish' },
  { before: muddyWheelArch, after: glossySidePanel, title: 'Exterior Detail & Wheel Clean' },
  { before: dustyTruckBed, after: cleanTruckBed, title: 'Truck Bed Deep Clean' },
  { before: dirtyRearFloor, after: shinyFrontGrille, title: 'Interior Vacuum & Detail' },
  { before: dirtyDriverFloorMat, after: cleanTruckSeats, title: 'Floor Mat Restoration' },
];
---

<BaseLayout title="Car Detailing Gallery | Car Wala" description="View our expert car detailing transformations in Karachi - paint correction, ceramic coating, PPF & more.">
  <Header client:load />
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-black focus:outline-none">Skip to main content</a>
  <main id="main-content" class="min-h-screen bg-background pt-[80px]">
    <div class="container mx-auto px-4 py-12">
      <div class="mb-12 text-center">
        <h1 class="text-2xl font-bold sm:text-3xl font-heading mb-4">
          Car Detailing Gallery
        </h1>
        <p class="text-sm text-muted-foreground sm:text-base font-body">
          Browse our portfolio of premium car care transformations
        </p>
      </div>

      <section class="mb-16">
        <h2 class="text-xl font-bold font-heading mb-6 text-center">
          Real Transformations
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
          {comparisonImages.map((comparison, i) => (
            <div class="flex flex-col items-center">
              <Compare
                firstImage={comparison.after}
                secondImage={comparison.before}
                firstImageClassName="object-cover w-full h-full"
                secondImageClassname="object-cover w-full h-full"
                className="w-full aspect-square rounded-lg border border-border"
                slideMode="drag"
                autoplay={false}
              />
              <p class="mt-3 text-sm text-muted-foreground font-body">
                {comparison.title}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="text-xl font-bold font-heading mb-6 text-center">
          Detailing Portfolio
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {galleryImages.map((item, i) => (
            <div
              class="group relative aspect-square overflow-hidden rounded-lg bg-muted"
            >
              <Picture
                src={item.src}
                alt={item.alt}
                loading="lazy"
                decoding="async"
                widths={[400, 800, 1200]}
                formats={['avif', 'webp']}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
  <Footer />
  <ElevenLabsWidget client:idle agentId="agent_0401km3y12mjf95a5h3yspgy3njr" />
</BaseLayout>