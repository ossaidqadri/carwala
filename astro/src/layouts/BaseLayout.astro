---
import { Font } from 'astro:assets';
import { QueryProvider } from '../components/QueryProvider';
import { ErrorBoundary } from '../components/ErrorBoundary';
import { WhatsAppWidget } from '../components/WhatsAppWidget';
import { Toaster } from 'sonner';
import '../styles/globals.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Professional car wash and detailing services in Karachi. Premium car care with mobile service available.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={Astro.url} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/Website Favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <Font cssVariable="--font-heading" preload />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-pixel" />
    <Font cssVariable="--font-accent" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Carwala" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://carwala.org/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://carwala.org/og-image.png" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      name: 'Carwala',
      legalName: 'Muhammad Areeb Ali',
      url: 'https://carwala.org',
      telephone: '+923310444333',
      email: 'support@carwala.org',
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'House No 512, New Iqbal Abad, Druh Road, Gulshan Town',
        addressLocality: 'Karachi East',
        addressRegion: 'Sindh',
        postalCode: '75300',
        addressCountry: 'PK',
      },
      sameAs: [
        'https://www.facebook.com/carwala.official',
        'https://www.instagram.com/carwala.official',
        'https://www.tiktok.com/@carswala.official',
        'https://www.linkedin.com/company/car-wala',
        'https://www.youtube.com/@carswala.official',
      ],
    })} />
  </head>
  <body class="font-body antialiased">
    <ErrorBoundary client:load>
      <QueryProvider client:idle>
        <slot />
        <WhatsAppWidget client:visible />
        <Toaster client:idle position="top-right" richColors />
      </QueryProvider>
    </ErrorBoundary>
  </body>
</html>